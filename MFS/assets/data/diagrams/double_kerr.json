nd open toward the cones of flat space far from the holes."],"source":{"fields":["coords","parameters","metric_components","inverse_metric_components","kretschmann","domains","einstein_tensor"],"version":"c4b3d6f21da81d15"},"slices":[{"view":"midplane","surface":0,"label":"$t = 0$","version":"e2347dc7bdab73ee","lines":[[[0.0,0.5],[1.0,0.5]]],"points":[],"fills":[],"place":{"at":[1.0,0.5],"anchor":"br","dx":0,"dy":-1.3}}]}]}}
