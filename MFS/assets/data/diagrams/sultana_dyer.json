r universe, beyond which both families gain $R$, and the curve $r = (\\sqrt{\\eta^2 + 12r_s\\eta + 4r_s^2} - \\eta - 2r_s)/4$, which leaves $r = 0$ at the big bang and climbs toward $r_s$ from inside, within which both families lose $R$."],"source":{"fields":["coords","parameters","metric_components","inverse_metric_components","kretschmann","domains"],"version":"338418234809d4e2"},"slices":[{"view":"paraboloid","surface":0,"label":"$\\eta = 3\\,r_s$","version":"bb9937ab2d11a365","lines":[[[0.0,0.375],[0.5,0.375]]],"points":[],"fills":[],"place":{"at":[0.5,0.375],"anchor":"br","dx":0,"dy":-1.3}},{"view":"paraboloid","surface":1,"label":"$\\eta = 4\\,r_s$","version":"a8c9ec6f5b24e93d","lines":[[[0.0,0.5],[0.5,0.5]]],"points":[],"fills":[],"place":{"at":[0.5,0.5],"anchor":"br","dx":0,"dy":-1.3}},{"view":"paraboloid","surface":2,"label":"$\\eta = 5\\,r_s$","version":"476ae73bc5528178","lines":[[[0.0,0.625],[0.5,0.625]]],"points":[],"fills":[],"place":{"at":[0.5,0.625],"anchor":"br","dx":0,"dy":-1.3}},{"view":"paraboloid","surface":3,"label":"$\\eta = 6\\,r_s$","version":"a929167629f25273","lines":[[[0.0,0.75],[0.5,0.75]]],"points":[],"fills":[],"place":{"at":[0.5,0.75],"anchor":"br","dx":0,"dy":-1.3}}]}],"schwarzschild_time":[{"id":"radial","label":"$t$ and $r$","plane":["t","r"],"families":["ingoing","outgoing"],"xlabel":"$r/r_s$","ylabel":"$ct/r_s$","ticks":{"x":[{"at":0.0,"label":"$0$"},{"at":2.0,"label":"$2$"},{"at":4.0,"label":"$4$"},{"at":6.0,"label":"$6$"}],"y":[{"at":0.0,"label":"$0$"},{"at":2.0,"label":"$2$"},{"at":4.0,"label":"$4$"},{"at":6.0,"label":"$6$"}]},"box":[0,7,-1,6],"to_display":[[0.0,1.0],[1.0,0.0]],"mirror":false,"rays":{"P":[[[0.5787,-0.015],[0.5192,0.0654],[0.4643,0.1429],[0.4153,0.2154],[0.3724,0.2829],[0.334,0.3474],[0.2992,0.4109],[0.2692,0.4714],[0.2439,0.5286],[0.2223,0.5845],[0.2043,0.6391],[0.1892,0.6946],[0.1769,0.7508],[0.167,0.8099],[0.1594,0.872],[0.1534,0.9417],[0.1491,1.0216]],[[0.6502,-0.0207],[0.5832,0.0665],[0.5236,0.1469],[0.468