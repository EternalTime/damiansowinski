 moment $t = 0$ has its opposite points identified."],"source":{"fields":["coords","parameters","metric_components","inverse_metric_components","kretschmann","domains"],"version":"ebb34c66d57f63e0"},"slices":[{"view":"moment","surface":0,"label":"$t = 0$","version":"ed0ee3b54f13ce8e","lines":[[[0.0833,0.5],[1.0,0.5]]],"points":[],"fills":[],"place":{"at":[1.0,0.5],"anchor":"br","dx":0,"dy":-1.3}}]}]}}
