shell reaches them and bend away from $r_s$ after.","The event horizon is the outgoing ray that reaches $r_s$ just as the shell does and stays there. It leaves the centre at $cv = -2r_s$, before the shell arrives, and crosses flat space, so an outgoing ray that leaves the centre after that moment ends at $r = 0$ even though its first stretch is flat. Behind the shell every future cone inside $r_s$ points to smaller $r$, and $r = 0$ is where the Kretschmann scalar $48G^2m^2/c^4r^6$ diverges."],"source":{"fields":["coords","parameters","metric_components","inverse_metric_components","kretschmann","domains"],"version":"e919f221603610eb"},"slices":[{"view":"shell","surface":0,"label":"$v - r = -3\\,r_s$","version":"aa53621388401023","lines":[[[0.0,0.0],[1.0,0.0]]],"points":[],"fills":[],"place":{"at":[1.0,0.0],"anchor":"br","dx":0,"dy":-1.3}},{"view":"shell","surface":1,"label":"$v - r = -1.5\\,r_s$","version":"b5ebeae947b474ce","lines":[[[0.0,0.3333],[1.0,0.3333]]],"points":[],"fills":[],"place":{"at":[1.0,0.3333],"anchor":"br","dx":0,"dy":-1.3}},{"view":"shell","surface":2,"label":"$v - r = -0.5\\,r_s$","version":"1381e970989f676e","lines":[[[0.0,0.5556],[1.0,0.5556]]],"points":[],"fills":[],"place":{"at":[1.0,0.5556],"anchor":"br","dx":0,"dy":-1.3}},{"view":"shell","surface":3,"label":"$v - r = 1\\,r_s$","version":"5b3f23cdbc993b7d","lines":[[[0.0,0.8889],[1.0,0.8889]]],"points":[],"fills":[],"place":{"at":[1.0,0.8889],"anchor":"br","dx":0,"dy":-1.3}}]}],"eddington_finkelstein_outgoing":[{"id":"shell","label":"an exploding shell","plane":["u","r"],"families":["ingoing","outgoing"],"xlabel":"$r/r_s$","ylabel":"$(cu + r)/r_s$","ticks":{"x":[{"at":0.0,"label":"$0$"},{"at":1.0,"label":"$1$"},{"at":2.0,"label":"$2$"},{"at":3.0,"label":"$3$"},{"at":4.0,"label":"$4$"}],"y":[{"at":-1.0,"label":"$-1$"},{"at":0.0,"label":"$0$"},{"at":1.0,"label":"$1$"},{"at":2.0,"label":"$2$"},{"at":3.0,"label":"$3$"}]},"box":[0,4,-1.5,3],"to_display":[[0.0,1.0],[1.0,1.0]],"mirror":false,"rays