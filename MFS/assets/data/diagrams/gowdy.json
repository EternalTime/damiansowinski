 at $\\tau$ whose $\\theta$ differ by more than $2e^{-\\tau}$ do not meet, and each $\\theta$ reaches the singularity with its own asymptotic velocity, $v(\\theta) = \\tfrac{1}{2}\\cos\\theta$."],"source":{"fields":["coords","parameters","metric_components","inverse_metric_components","kretschmann","domains","einstein_tensor"],"version":"c450803c33f2c0a0"},"slices":[{"view":"torus","surface":0,"label":"$t = 0.25$","version":"0ecb278cdf51b9eb","lines":[[[0.0,0.4356],[1.0,0.4356]]],"points":[],"fills":[],"place":{"at":[1.0,0.4356],"anchor":"br","dx":0,"dy":-1.3}},{"view":"torus","surface":1,"label":"$t = 0.5$","version":"e15f0aa20a7b6788","lines":[[[0.0,0.5511],[1.0,0.5511]]],"points":[],"fills":[],"place":{"at":[1.0,0.5511],"anchor":"br","dx":0,"dy":-1.3}},{"view":"torus","surface":2,"label":"$t = 1$","version":"2b6da18427ae478c","lines":[[[0.0,0.6667],[1.0,0.6667]]],"points":[],"fills":[],"place":{"at":[1.0,0.6667],"anchor":"br","dx":0,"dy":-1.3}},{"view":"torus","surface":3,"label":"$t = 2$","version":"91b525fa456eef14","lines":[[[0.0,0.7822],[1.0,0.7822]]],"points":[],"fills":[],"place":{"at":[0.0,0.7822],"anchor":"tl","dx":0,"dy":1.3}},{"view":"torus","surface":4,"label":"$t = 3$","version":"cf55cd25bc13897e","lines":[[[0.0,0.8498],[1.0,0.8498]]],"points":[],"fills":[],"place":{"at":[1.0,0.8498],"anchor":"br","dx":0,"dy":-1.3}}]}],"sphere":[{"id":"plane","label":"$t$ and $\\theta$","plane":["t","\\theta"],"families":["moving left","moving right"],"xlabel":"$\\theta$","ylabel":"$t$","ticks":{"x":[{"at":0.0,"label":"$0$"},{"at":1.0,"label":"$1$"},{"at":2.0,"label":"$2$"},{"at":3.0,"label":"$3$"}],"y":[{"at":0.0,"label":"$0$"},{"at":1.0,"label":"$1$"},{"at":2.0,"label":"$2$"},{"at":3.0,"label":"$3$"}]},"box":[0,3.141592653589793,0,3.141592653589793],"to_display":[[0.0,1.0],[1.0,0.0]],"mirror":false,"rays":{"P":[[[0.0545,-0.0202],[-0.0215,0.0558]],[[0.1212,-0.0202],[-0.0202,0.1212]],[[0.1879,-0.0202],[-0.0207,0.1884]],[[0.2545,-0.0202],[-0.0212,0.2556]],[[0.3212,-0.0