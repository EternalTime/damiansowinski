{
  "id": "superconducting_string",
  "name": "Superconducting Cosmic String",
  "short_name": "Superconducting Cosmic String",
  "description": "The exterior of a straight superconducting cosmic string carrying a current and surrounded by a magnetic field.",
  "tags": [
    "topological defect",
    "cosmic string",
    "electrovacuum",
    "electromagnetic field",
    "magnetic field",
    "cylindrical symmetry",
    "axisymmetric",
