{
  "id": "minkowski",
  "name": "Minkowski Flat Spacetime",
  "short_name": "Minkowski",
  "description": "The flat spacetime of special relativity. No curvature, no gravity.",
  "tags": [
    "flat",
    "special relativity",
    "vacuum",
    "vacuum solution",
    "static",
