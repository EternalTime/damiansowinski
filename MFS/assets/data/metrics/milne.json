    "cosmology",
    "cosmological",
    "expanding universe",
    "open universe",
    "hyperbolic space",
    "empty universe",
    "flat",
    "vacuum",
    "vacuum solution",
    "special relativity",
    "homogeneous",
    "isotropic",
    "FLRW",
    "time-dependent",
    "exact solution",
    "Lorentzian",
    "four-dimensional",
    "idealized model"
  ],
