"surface","the equator $\\chi = \\pi/2$, glued to itself with the time reversed"],["line","centre","the observer, $\\chi = 0$"],["line","horizon","the observer's horizons"],["line","scri","infinity $\\mathscr{I}^\\pm$, the two halves of one sphere"]],"slices":[{"view":"moment","surface":0,"label":"$t = 0$","version":"5484fa797f6f10b7","lines":[[[0.0,0.0],[1.5708,0.0]]],"points":[],"fills":[],"place":{"at":[1.5708,0.0],"anchor":"br","dx":0,"dy":-1.3}}]},{"id":"kruskal","label":"Kruskal","box":[-0.75,2.3208,-1.8708,1.8708],"system":"kruskal","caption":["The Kruskal chart's null coordinates enter as $p = \\arctan V - \\pi/4$ and $q = \\arctan U + \\pi/4$, so their lines run at 45°. The half $V \\ge U$ of the chart is the half square: the observer $UV = -1$ is the left edge, infinity $UV = 1$ the top and the bottom, and $U = V$ the glued edge."],"layers":[{"kind":"fill","class":"region","points":[[0.0,-1.5708],[1.5708,-1.5708],[1.5708,1.5708],[0.0,1.5708]]},{"kind":"fill","class":"cover","points":[[0.0,-1.5708],[1.5708,-1.5708],[1.5708,1.5708],[0.0,1.5708]]},{"kind":"line","class":"scri","points":[[0.0,1.5708],[1.5708,1.5708]]},{"kind":"line","class":"scri","points":[[0.0,-1.5708],[1.5708,-1.5708]]},{"kind":"line","class":"centre","points":[[0.0,-1.5708],[0.0,1.5708]]},{"kind":"line","class":"horizon","points":[[0.0,-1.5708],[1.5708,0.0]]},{"kind":"line","class":"horizon","points":[[0.0,1.5708],[1.5708,0.0]]},{"kind":"line","class":"surface","points":[[1.5708,-1.5708],[1.5708,1.5708]]},{"kind":"line","class":"null","points":[[1.15,1.0],[1.5708,0.5792]]},{"kind":"line","class":"null","points":[[1.5708,-0.5792],[0.0,0.9916]]},{"kind":"line","class":"t","points":[[0.9261,-1.5696],[0.0012,-0.6447]]},{"kind":"line","class":"t","points":[[1.5701,-1.5701],[0.0007,-0.0007]]},{"kind":"line","class":"t","points":[[1.5696,-0.9261],[0.0001,0.6434]]},{"kind":"line","class":"r","points":[[0.9274,-1.5707],[1.5694,-0.9287]]},{"kind":"line","class":"t","points":[[1.5694,0.9287],[0.9274,