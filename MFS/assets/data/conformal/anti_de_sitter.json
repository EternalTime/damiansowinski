{"metric":"anti_de_sitter","source":[{"metric":"anti_de_sitter","system":"poincare","fields":["coords","inverse_metric_components","metric_components","parameters"],"version":"2a044533b098891e"},{"metric":"anti_de_sitter","system":"static_global","fields":["coords","inverse_metric_components","kretschmann","metric_components","parameters"],"version":"6e82eb70bc3331b9"}],"views":[{"id":"global","label":"Static global","box":[-0.95,2.1208,-0.9425,4.0841],"system":"static_global","fade":{"top":0.7,"bottom":0.7},"caption":["This is the whole of anti-de Sitter spacetime, its universal cover, each point a sphere. With $\\sigma = \\arctan(r/L)$ the metric on the plane of $t$ and $r$ is $\\frac{1}{\\cos^2\\sigma}(-c^2dt^2 + L^2d\\sigma^2)$, conformal as it stands to the strip $0 \\le \\sigma < \\pi/2$, infinite in $t$, whose edge $\\sigma = \\pi/2$ is a timelike boundary.","A radial light ray from the centre reaches the boundary at $ct = \\pi L/2$ and is back at $ct = \\pi L$, and the radial timelike geodesics, $\\sin\\sigma = k\\sin(ct/L)$ with $k < 1$, all return to the centre at $ct = \\pi L$ whatever their energy."],"layers":[{"kind":"fill","class":"region","points":[[0.0,-0.9425],[1.5708,-0.9425],[1.5708,4.0841],[0.0,4.0841]]},{"kind":"fill","class":"cover","points":[[0.0,-0.9425],[1.5708,-0.9425],[1.5708,4.0841],[0.0,4.0841]]},{"kind":"line","class":"boundary","points":[[1.5708,-0.9425],[1.5708,4.0841]]},{"kind":"line","class":"centre","points":[[0.0,-0.9425],[0.0,4.0841]]},{"kind":"line","class":"r","points":[[0.245,-0.9425],[0.245,4.0841]]},{"kind":"line","class":"r","points":[[0.4636,-0.9425],[0.4636,4.0841]]},{"kind":"line","class":"r","points":[[0.7854,-0.9425],[0.7854,4.0841]]},{"kind":"line","class":"r","points":[[1.1071,-0.9425],[1.1071,4.0841]]},{"kind":"line","class":"r","points":[[1.3258,-0.9425],[1.3258,4.0841]]},{"kind":"line","class":"t","points":[[0.0,-0.7854],[1.5708,-0.7854]]},{"kind":"line","class":"t","points":[[0.0,0.0],[1.5708,0.0]]},{"kind":"line