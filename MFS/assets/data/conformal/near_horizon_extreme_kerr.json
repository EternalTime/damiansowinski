hese coordinates, so the throat has no singularity and no edge short of its two boundaries."],"layers":[{"kind":"fill","class":"region","points":[[-1.5708,-3.4558],[1.5708,-3.4558],[1.5708,3.4558],[-1.5708,3.4558]]},{"kind":"fill","class":"cover","points":[[-1.5708,-3.4558],[1.5708,-3.4558],[1.5708,3.4558],[-1.5708,3.4558]]},{"kind":"line","class":"boundary","points":[[1.5708,-3.4558],[1.5708,3.4558]]},{"kind":"line","class":"boundary","points":[[-1.5708,-3.4558],[-1.5708,3.4558]]},{"kind":"line","class":"r","points":[[-1.3258,-3.4558],[-1.3258,3.4558]]},{"kind":"line","class":"r","points":[[-1.1071,-3.4558],[-1.1071,3.4558]]},{"kind":"line","class":"r","points":[[-0.7854,-3.4558],[-0.7854,3.4558]]},{"kind":"line","class":"r","points":[[-0.4636,-3.4558],[-0.4636,3.4558]]},{"kind":"line","class":"r","points":[[0.0,-3.4558],[0.0,3.4558]]},{"kind":"line","class":"r","points":[[0.4636,-3.4558],[0.4636,3.4558]]},{"kind":"line","class":"r","points":[[0.7854,-3.4558],[0.7854,3.4558]]},{"kind":"line","class":"r","points":[[1.1071,-3.4558],[1.1071,3.4558]]},{"kind":"line","class":"r","points":[[1.3258,-3.4558],[1.3258,3.4558]]},{"kind":"line","class":"t","points":[[-1.5708,-3.0],[1.5708,-3.0]]},{"kind":"line","class":"t","points":[[-1.5708,-2.0],[1.5708,-2.0]]},{"kind":"line","class":"t","points":[[-1.5708,-1.0],[1.5708,-1.0]]},{"kind":"line","class":"t","points":[[-1.5708,0.0],[1.5708,0.0]]},{"kind":"line","class":"t","points":[[-1.5708,1.0],[1.5708,1.0]]},{"kind":"line","class":"t","points":[[-1.5708,2.0],[1.5708,2.0]]},{"kind":"line","class":"t","points":[[-1.5708,3.0],[1.5708,3.0]]}],"labels":[{"at":[-1.5708,0.6],"text":"$\\mathscr{I}$","anchor":"r","class":"lab","dx":-6,"dy":0},{"at":[1.5708,0.6],"text":"$\\mathscr{I}$","anchor":"l","class":"lab","dx":6,"dy":0},{"at":[0.7854,0.5],"text":"$y = 1$","anchor":"b","class":"coord","dx":0,"dy":-3}],"legend":[["fill","cover","the whole throat, which $\\tau$ and $y$ cover"],["line","r","$y$ constant, from $-4$ to $4$"],["line","